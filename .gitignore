# ---------------------------------------------------------------
# CREDENCIAIS - a regra mais importante deste arquivo.
# ---------------------------------------------------------------
# Qualquer nome contendo "secrets", em qualquer diretorio e em qualquer
# combinacao de maiusculas/minusculas. Duas licoes que custaram um teste
# cada:
#   1. Regra estreita ("src/secrets.h") deixava passar secrets.h.bak e
#      secrets_backup.h - a copia que se faz sem pensar antes de editar
#      uma senha.
#   2. O gitignore diferencia maiusculas: "*secrets*" NAO pega SECRETS.h.
# Dai as classes de caractere abaixo. Sao feias, mas cobrem as 128
# combinacoes de caixa; um nome de arquivo nao vale o risco da senha.
*[Ss][Ee][Cc][Rr][Ee][Tt][Ss]*
**/*[Ss][Ee][Cc][Rr][Ee][Tt][Ss]*
*[Cc][Rr][Ee][Dd][Ee][Nn][Tt][Ii][Aa][Ll][Ss]*
[Cc]redentials.h
**/[Cc]redentials.h
.env
.env.*
*.pem
*.key

# O template publicavel e a UNICA excecao: ele nao tem valores reais.
!secrets.example.h
!**/secrets.example.h
!.env.example

# Backups de qualquer arquivo. Um "cp x x.bak" antes de mexer na senha
# nao pode virar commit.
*.bak
*.old
*.orig
*.save
*.swp
*~

# ---------------------------------------------------------------
# ARTEFATOS DE BUILD
# ---------------------------------------------------------------
# ATENCAO: o firmware compilado guarda o SSID e a SENHA em texto
# claro (verificavel com `strings firmware.bin`). Nunca versionar.
.pio/
*.bin
*.elf
*.map

# ---------------------------------------------------------------
# GERADOS POR IDE / FERRAMENTAS (ruido, e vazam /home/<usuario>)
# ---------------------------------------------------------------
compile_commands.json
.vscode/.browse.c_cpp.db*
.vscode/c_cpp_properties.json
.vscode/launch.json
.vscode/ipch
.claude/settings.local.json

# Relatorios e rascunhos de sessao de trabalho. Ficam no diretorio do
# projeto por conveniencia, mas nao sao o projeto - um "git add -A"
# publicaria material de bastidor no repositorio.
#
# ATENCAO: os relatorios de revisao contem o MAC e o IP reais da rede em
# texto claro, discutindo justamente o que tirar do codigo. Esta linha e o
# que impede isso de chegar a um repositorio publico. Nao remover.
Claude outputs/

# Workflow pessoal de quem desenvolve, nao faz parte do projeto publicado.
CLAUDE.md

# Sistema operacional
.DS_Store
Thumbs.db
